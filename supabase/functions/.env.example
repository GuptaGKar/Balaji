# Local Supabase Edge Function secrets. Copy to supabase/functions/.env (ignored).
SEND_SMS_HOOK_SECRET=v1,whsec_replace_with_generated_secret
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=replace_with_2factor_api_key
TWOFACTOR_TEMPLATE_NAME=replace_with_dlt_approved_template_name

# Optional own-SIM gateway fallback (not the current path).
SMS_GATEWAY_URL=https://sms-gateway.example.com
SMS_GATEWAY_API_KEY=replace_with_gateway_api_key
SMS_GATEWAY_CF_ACCESS_CLIENT_ID=
SMS_GATEWAY_CF_ACCESS_CLIENT_SECRET=
