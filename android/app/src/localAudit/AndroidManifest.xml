<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/local_audit_network_security">
        <meta-data android:name="com.balaji.provision.LOCAL_AUDIT" android:value="true" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" />
        <service android:name="com.balaji.provision.push.BalajiMessagingService" tools:node="remove" />
    </application>
</manifest>
