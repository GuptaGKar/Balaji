# Balaji Provision Store — environment variables
# Copy to .env.local (web) / .env (supabase functions). NEVER commit real values.
# Names + descriptions only here. See docs/IMPLEMENTATION_PLAN.md §13.

# ---- Web (server-only unless prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL (public, safe in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase anon key (public, safe in browser)
SUPABASE_SERVICE_ROLE_KEY=           # SERVER-ONLY. Used only by web/src/server/supabaseAdmin.ts (rider/staff provisioning). Never expose to browser or Android.
APP_BASE_URL=                        # Public base URL of the web app, e.g. https://store.example.com
STORE_TIMEZONE=Asia/Kolkata          # Store timezone for hours and timestamp display

# ---- Payments (leave empty until the payment gate M11 opens) ----
PAYMENT_PROVIDER=                    # e.g. razorpay | phonepe (decided by owner at M11)
PAYMENT_KEY_ID=                      # server-only
PAYMENT_KEY_SECRET=                  # server-only
PAYMENT_WEBHOOK_SECRET=              # server-only, used to verify webhook signatures

# ---- Notifications (optional; MVP uses in-app status + manual phone contact) ----
FCM_SERVER_CREDENTIALS_PATH=         # path to service-account JSON, server-only
SMS_PROVIDER_KEY=                    # server-only
